namespace winscp = "http://winscp.net/schema/session/1.0"

<winscp:session>
start = "winscp:session/@start"
{
    <winscp:download>
    ["winscp:download/@success" = "true"]
    result = "winscp:download/@success"
    {
        filename = "winscp:filename/@value"
        destination = "winscp:destination/@value"
    }
}
