namespace configured = "urn:unstruct:test"

{
    <configured:Record>
    ["configured:Record/@status" = "keep"]
    {
        id = "configured:id"
        kind = "configured:id/@kind"
        <configured:Item> {
            value = "configured:value"
            unit = "configured:value/@unit"
            missing = "configured:missing"
        }
    }
}