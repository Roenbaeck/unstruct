config = { SOI ~ xml_namespace* ~ (dictionary | element | directive | filter | block)+ ~ EOI }

// built-in removal 
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

digit = _{ '0'..'9' }
column_name = ${ (CASED_LETTER | "_") ~ (CASED_LETTER | digit | "_" )* }
namespace_prefix = @{ (CASED_LETTER | "_") ~ (CASED_LETTER | digit | "_" | "-" | ".")* }
namespace_uri = @{ (!"\"" ~ ANY)+ }
xml_namespace = { "namespace" ~ namespace_prefix ~ "=" ~ "\"" ~ namespace_uri ~ "\"" }
xml_name = { ( "\"\"" | (!"\"" ~ ANY) )* }

element = { "<" ~ (!">" ~ ANY)* ~ ">" }
directive = { column_name ~ "=" ~ (lookup | quoted_selector) }
quoted_selector = { "\"" ~ xml_name ~ "\"" }
lookup = { column_name ~ "[" ~ quoted_selector ~ "]" }
dictionary = { "dictionary" ~ column_name ~ "{" ~ (dictionary_flag | dictionary_field)* ~ "}" }
dictionary_flag = { "lenient" }
dictionary_field = { dictionary_field_name ~ "=" ~ quoted_selector }
dictionary_field_name = { "entry" | "key" | "value" }
value = { ( "\"\"" | (!"\"" ~ ANY) )* }
filter = { "[" ~ (lookup | quoted_selector) ~ "=" ~ "\"" ~ value ~ "\"" ~ "]" }
block = { "{" ~ (dictionary | element | directive | filter | block)* ~ "}" }
